pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                if grep -r "password" app.py; then
                    echo "Hardcoded secret detected!"
                    exit 1
                else
                    echo "No hardcoded secrets found."
                fi
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
            }
        }
    }
}
